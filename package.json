{
  "name": "gece-kosusu-fnaf",
  "version": "1.0.0",
  "description": "FNAF temali sonsuz kosu oyunu",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --publish never",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android"
  },
  "build": {
    "appId": "com.fnaf.nightrunner",
    "productName": "GeceKosusu",
    "files": ["electron-main.js", "www/**/*"],
    "win": { "target": "portable" },
    "directories": { "output": "dist" }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "@capacitor/cli": "^6.1.0"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.0",
    "@capacitor/android": "^6.1.0"
  }
}
